<?xml version="1.0" encoding="utf-8"?>
<!--
    Pure black backing: Android draws adaptive layers over black anyway, and black gives the knob's
    mint glow the most contrast. The knob sits inside the 66dp safe zone, so no launcher mask
    (circle, squircle, MIUI's square tile) clips it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/iconBackground" />
    <foreground android:drawable="@mipmap/ic_foreground" />
</adaptive-icon>
